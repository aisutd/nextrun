{
  "expo": {
    "name": "NextRun",
    "slug": "nextrun",
    "version": "1.0.0",
    "orientation": "default",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": { "supportsTablet": true, "bundleIdentifier": "com.nextrun.app" },
    "android": { "package": "com.nextrun.app", "edgeToEdgeEnabled": true },
    "web": { "bundler": "metro", "output": "single" },
    "plugins": [
      "expo-font",
      [
        "expo-image-picker",
        {
          "photosPermission": "Choose a selfie for your NextRun player card.",
          "cameraPermission": false,
          "microphonePermission": false
        }
      ]
    ]
  }
}
