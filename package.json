{
  "name": "nextrun",
  "version": "1.0.0",
  "private": true,
  "main": "index.ts",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit",
    "test": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --test tests/*.test.mjs",
    "export:web": "expo export --platform web",
    "check": "npm run typecheck && npm test",
    "assets:registry": "node scripts/build-asset-registry.cjs",
    "format": "prettier --write App.tsx index.ts src scripts tests *.js *.json"
  },
  "dependencies": {
    "expo": "~54.0.38",
    "expo-asset": "~12.0.14",
    "expo-audio": "~1.1.1",
    "expo-crypto": "~15.0.8",
    "expo-document-picker": "~14.0.8",
    "expo-file-system": "~19.0.21",
    "expo-font": "~14.0.12",
    "expo-image-picker": "~17.0.11",
    "expo-secure-store": "~15.0.8",
    "expo-sharing": "~14.0.8",
    "nativewind": "4.2.1",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "0.81.5",
    "react-native-reanimated": "~4.1.1",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-web": "^0.21.0",
    "react-native-worklets": "0.5.1"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@types/react": "~19.1.10",
    "babel-preset-expo": "~54.0.10",
    "prettier": "^3.9.10",
    "tailwindcss": "3.4.17",
    "typescript": "~5.9.2"
  },
  "engines": {
    "node": ">=20.19.4"
  }
}
